# JDLabs Environment Configuration (Local AI Stack)
# Copy this file to .env and fill in your values

# ===========================================
# AI BACKEND CONFIGURATION
# ===========================================
# Options: 'local' or 'gemini'
# Use 'local' for Ollama+Whisper+Piper stack
# Use 'gemini' for Google Gemini Live API
AI_BACKEND=local

# ===========================================
# LOCAL AI SERVICES (for AI_BACKEND=local)
# ===========================================
OLLAMA_URL=http://localhost:11434
WHISPER_URL=http://localhost:9000
PIPER_URL=http://localhost:10200

# Ollama Model Configuration
OLLAMA_MODEL=gemma2:2b-instruct-q4
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# Whisper Configuration
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en

# Piper Configuration
PIPER_VOICE=en_US-lessac-medium
PIPER_SAMPLE_RATE=24000

# ===========================================
# GOOGLE GEMINI (for AI_BACKEND=gemini)
# ===========================================
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest
GOOGLE_OAUTH_TOKEN=your_oauth_token_here

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================================
# SUPABASE DATABASE
# ===========================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===========================================
# FRONTEND
# ===========================================
VITE_APP_URL=http://localhost:3000

# ===========================================
# AUDIO PROCESSING
# ===========================================
# Maximum audio chunk size in bytes (5MB)
MAX_AUDIO_CHUNK_SIZE=5242880

# Audio conversion settings
AUDIO_SAMPLE_RATE=24000
AUDIO_CHANNELS=1
AUDIO_BIT_DEPTH=16

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_TEXT_REQUESTS=30
RATE_LIMIT_AUDIO_CHUNKS=200
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info
# Options: error, warn, info, debug, trace
